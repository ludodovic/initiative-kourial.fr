{
  "name": "initiative-kourial",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "generate:library": "node scripts/generate-library-manifest.js",
    "prestart": "npm run generate:library",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:docker": "ng serve --proxy-config proxy.docker.conf.json",
    "prebuild": "npm run generate:library",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.0"
  }
}
